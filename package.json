{
  "name": "decisionengine",
  "version": "0.1.0",
  "description": "Capture your team's decisions as you make them, and hold every coding agent to them.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "de": "dist/cli.js",
    "decisionengine": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "adr",
    "decisions",
    "ai-agents",
    "mcp",
    "claude-code",
    "governance"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.3",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sighup/decisionengine.git"
  },
  "homepage": "https://github.com/sighup/decisionengine#readme"
}
